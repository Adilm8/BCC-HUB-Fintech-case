# Скопируйте этот файл в .env и впишите свой ключ.
# Файл .env в git не попадает (см. .gitignore).

# LLM-провайдер: gemini (по умолчанию, есть бесплатный тариф) или anthropic
LLM_PROVIDER=gemini

# Ключ Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Основная модель и запасные (через запятую): запасная берётся, если основная перегружена (503) или
# исчерпан дневной лимит. gemini-3.5-flash работает на бесплатном ключе; если вашему ключу доступна
# gemini-3.8-flash, рекомендуем её как основную (GEMINI_MODEL=gemini-3.8-flash) или первой в списке запасных.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# Ключ Anthropic API (если LLM_PROVIDER=anthropic). Пустая модель = claude-sonnet-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_FALLBACK_MODELS=

# Повторы при ошибках 429/503
LLM_MAX_RETRIES=4
LLM_RETRY_BASE_SECONDS=8
