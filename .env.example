# Скопируйте этот файл в .env и впишите свой ключ.
# Файл .env в git не попадает (см. .gitignore).

# LLM-провайдер: gemini (по умолчанию, есть бесплатный тариф) или anthropic
LLM_PROVIDER=gemini

# Ключ Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Основная модель и запасные (через запятую), если основная перегружена или исчерпан лимит
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# Повторы при ошибках 429/503
LLM_MAX_RETRIES=4
LLM_RETRY_BASE_SECONDS=8

# Другие провайдеры (необязательно)
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ANTHROPIC_API_KEY: ключ из консоли разработчика провайдера
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_FALLBACK_MODELS=
